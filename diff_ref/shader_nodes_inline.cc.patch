+  /**
+   * Links that should be considered during inlining.
+   *
+   * Matches the legacy (pre-inline) GPU compilation: links whose
+   * NODE_LINK_VALID flag is unset (marked by the tree update for cycles and
+   * broken connections) are skipped, exactly like the old node exec system
+   * ignored them.  The topology-cache helpers (`is_used`/`is_available`)
+   * do not look at NODE_LINK_VALID, so cyclic links would otherwise make
+   * `has_available_link_cycle()` true and abort inlining, turning the whole
+   * material black (Goo Engine legacy files legitimately contain such
+   * cycles, e.g. a texture vector fed from a node group output that consumes
+   * the same texture).
+   */
+  static bool link_is_usable(const bNodeLink *link)
+  {
+    return link->is_used() && (link->flag & NODE_LINK_VALID) != 0;
+  }
+
+  /** Kahn's algorithm over usable links only. */
+  bool has_cycle_over_usable_links(const bNodeTree &tree) const
+  {
+    Map<const bNode *, int> in_degree;
+    Vector<const bNode *> nodes;
+    for (const bNode *node : tree.runtime->nodes_by_id) {
+      nodes.append(node);
+      in_degree.add(node, 0);
+    }
+    for (const bNode *node : nodes) {
+      for (const bNodeSocket *socket : node->runtime->inputs) {
+        for (const bNodeLink *link : socket->directly_linked_links()) {
+          if (link_is_usable(link)) {
+            in_degree.add(node, in_degree.lookup(node) + 1);
+          }
+        }
+      }
+    }
+    Vector<const bNode *> queue;
+    for (const bNode *node : nodes) {
+      if (in_degree.lookup(node) == 0) {
+        queue.append(node);
+      }
+    }
+    int removed = 0;
+    while (!queue.is_empty()) {
+      const bNode *node = queue.pop_last();
+      removed++;
+      for (const bNodeSocket *socket : node->runtime->outputs) {
+        for (const bNodeLink *link : socket->directly_linked_links()) {
+          if (!link_is_usable(link)) {
+            continue;
+          }
+          const bNode *target = link->tonode;
+          const int new_degree = in_degree.lookup(target) - 1;
+          in_degree.add(target, new_degree);
+          if (new_degree == 0) {
+            queue.append(target);
+          }
+        }
+      }
+    }
+    return removed < nodes.size();
+  }
+
